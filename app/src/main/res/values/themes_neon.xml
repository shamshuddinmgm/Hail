        <item name="actionBarTheme">@style/Theme.Hail.AppBarOverlay</item>
        <item name="toolbarStyle">@style/Widget.Material3.Toolbar</item>
        <item name="bottomNavigationStyle">@style/Widget.Hail.BottomNav</item>
