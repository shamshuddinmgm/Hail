<?xml version="1.0" encoding="utf-8"?>
<!-- SplashScreen animated icon — solid tint (no theme attrs; inflate is pre-theme). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:width="108dp"
        android:height="108dp"
        android:gravity="center">
        <shape android:shape="oval">
            <solid android:color="#162033" />
        </shape>
    </item>
    <item
        android:width="56dp"
        android:height="56dp"
        android:drawable="@drawable/ic_splash_flake"
        android:gravity="center" />
</layer-list>
