<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <include
        android:id="@+id/app_bar_main"
        layout="@layout/app_bar_main"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/bottom_nav"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Custom bar: compact Home/Apps/Settings cluster + wide Search tap zone -->
    <LinearLayout
        android:id="@+id/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurfaceContainer"
        android:gravity="center_vertical"
        android:minHeight="@dimen/bottom_nav_height"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/bottom_nav_bar_pad_h"
        android:paddingVertical="@dimen/bottom_nav_bar_pad_v"
        app:layout_constraintBottom_toBottomOf="parent"
        tools:ignore="SplitPairRule">

        <LinearLayout
            android:id="@+id/nav_cluster"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/bottom_nav_cluster_pad_start"
            tools:ignore="RtlSymmetry">

            <include
                android:id="@+id/nav_home"
                layout="@layout/view_bottom_nav_chip"
                android:layout_width="wrap_content"
                android:layout_height="match_parent" />

            <include
                android:id="@+id/nav_apps"
                layout="@layout/view_bottom_nav_chip"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/bottom_nav_chip_gap" />

            <include
                android:id="@+id/nav_settings"
                layout="@layout/view_bottom_nav_chip"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/bottom_nav_chip_gap" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_search"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/bottom_nav_search_margin_start"
            android:layout_weight="1"
            android:background="@drawable/bg_nav_search"
            android:clickable="true"
            android:contentDescription="@string/action_search"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/padding_medium">

            <ImageView
                android:id="@+id/nav_search_icon"
                android:layout_width="@dimen/bottom_nav_icon_size"
                android:layout_height="@dimen/bottom_nav_icon_size"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_outline_search" />

            <TextView
                android:id="@+id/nav_search_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/action_search"
                android:textAppearance="?attr/textAppearanceLabelLarge"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
